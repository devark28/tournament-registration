meta {
  name: email sign in
  type: http
  seq: 4
}

post {
  url: {{BASE_URL}}/api/auth/sign-in/email
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Origin: {{BASE_URL}}
}

body:json {
  {
    "email": "user1@example.com",
    "password": "Str0ng!Pass"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: email sign in response
  
  request: {
    url: {{BASE_URL}}/api/auth/sign-in/email
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
      Origin: {{BASE_URL}}
    }
  
    body:json: {
      {
        "name": "User1",
        "email": "user1@example.com",
        "password": "Str0ng!Pass"
      }
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: http://localhost:3000
      vary: Origin
      access-control-allow-credentials: true
      content-type: application/json
      set-cookie: better-auth.session_token=<SESSION_TOKEN>; Max-Age=604800; Path=/; HttpOnly; SameSite=Lax
      date: Wed, 11 Feb 2026 20:37:08 GMT
      connection: keep-alive
      keep-alive: timeout=5
      transfer-encoding: chunked
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "redirect": false,
          "token": "<SESSION_TOKEN>",
          "user": {
            "name": "User1",
            "email": "user1@example.com",
            "emailVerified": false,
            "image": null,
            "createdAt": "2026-02-11T20:24:15.350Z",
            "updatedAt": "2026-02-11T20:24:15.350Z",
            "id": "eYatS9SJ1gnc0XwMRbby5NY39ofRBJNK"
          }
        }
      '''
    }
  }
}
