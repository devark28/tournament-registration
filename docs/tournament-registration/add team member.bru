meta {
  name: add team member
  type: http
  seq: 6
}

post {
  url: {{BASE_URL}}/teams/:id/members
  body: json
  auth: inherit
}

params:path {
  id: 7
}

body:json {
  {
    "userId": "<USER_ID>"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: add team member response
  
  request: {
    url: {{BASE_URL}}/teams/:id/members
    method: POST
    mode: json
    params:path: {
      id: 7
    }
  
    body:json: {
      {
        "userId": "<USER_ID>"
      }
    }
  }
  
